# Meta hackathon work (2026-10-26..11-04). Copy the values into the private .env (never commit keys).
# Each provider is OpenAI-compatible: <URL>/chat/completions. Unset providers are skipped.
# VERIFY every URL and model id against the official participant docs before use.

# Meta Model API (closed weights, cloud). From dev.meta.ai/docs/overview (read 2026-10-28):
# base URL https://api.meta.ai/v1, Bearer MODEL_API_KEY, OpenAI-SDK compatible; Muse Spark models
# muse-spark-1.3 / 1.2 / 1.1; also muse-wonder-1.0, muse-image-1.0, muse-voice-transcribe-1.0, sam-3.1.
META_AI_META_API_URL=https://api.meta.ai/v1
META_AI_META_API_KEY=
META_AI_META_API_MODEL=muse-spark-1.3
META_AI_META_API_IMAGES=1

# Baseten (open weights, cloud) - model id as given in hackathon rules
META_AI_BASETEN_URL=
META_AI_BASETEN_KEY=
META_AI_BASETEN_MODEL=meta-models/muse-spark-open-1026

# Modal (open weights, cloud, vLLM)
META_AI_MODAL_URL=
META_AI_MODAL_KEY=
META_AI_MODAL_MODEL=

# Self-hosted (optional, NOT used for the hackathon: cloud-only decision 2026-10-27). Leave unset to skip.
# Plain http is allowed only for loopback or a Tailscale 100.64.0.0/10 address.
META_AI_LOCAL_MAC_URL=
META_AI_LOCAL_MAC_MODEL=
META_AI_LOCAL_MAC_JSON_SCHEMA=1
META_AI_LOCAL_MAC_IMAGES=0
META_AI_LOCAL_V100_URL=
META_AI_LOCAL_V100_MODEL=

# Optional per provider: _TIMEOUT_MS (1000-120000, default 20000)

# Tap + Messenger (BitPOS × Muse). Keep real values only in the private .env.
# 16-byte master key (32 hex) for NTAG424 per-sticker key derivation. Never reuse across environments.
META_TAP_MASTER_KEY=
# Customer-facing origin that serves /meta/* (routed straight to the API process).
META_PUBLIC_URL=
META_MESSENGER_APP_SECRET=
META_MESSENGER_VERIFY_TOKEN=
META_MESSENGER_PAGE_TOKEN=
META_GRAPH_VERSION=v24.0
