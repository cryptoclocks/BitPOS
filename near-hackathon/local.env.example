# NEAR HACKATHON work (2026-11-14). See near-hackathon/PROVENANCE.md.
# Copy to the repository root as `.env` for the LOCAL preview and tests only (disposable fixture database).
# Replace <you> with your OS user name (the fixture uses trust authentication on 127.0.0.1) and set APP_SECRET
# to any random string of 32+ characters.
DATABASE_URL=postgresql://bitpos_app@127.0.0.1:55477/bitpos_near_fixture
ADMIN_DATABASE_URL=postgresql://<you>@127.0.0.1:55477/bitpos_near_fixture
# tools/near/dev-auth.ts answers sign-in here for the fixture's demo accounts.
AUTH_URL=http://127.0.0.1:55478
AUTH_ANON_KEY=local-fixture-anon
APP_SECRET=
PUBLIC_URL=http://127.0.0.1:4321/
BITPOS_DEMO_QUICK_SIGNIN=1
# Quick sign-in goes to the NEAR edition's demo shop (Orbit Café) instead of the default demo shop.
BITPOS_DEMO_SHOP=near
# Required by the shared config of the pre-existing POS; the NEAR edition never uses them.
SOLANA_RPC=https://api.devnet.solana.com
DEVNET_PRIVATE_DIR=/tmp/bitpos-devnet-unused
# NEAR testnet (public ids only; keys live in NEAR_PRIVATE_DIR, outside the repository).
NEAR_NETWORK=testnet
NEAR_BILLS_CONTRACT=bills.bitpos-near.testnet
NEAR_RELAYER_ACCOUNT=relayer.bitpos-near.testnet
NEAR_DEMO_WALLETS=alice.bitpos-near.testnet,bob.bitpos-near.testnet
NEAR_AI_AGENT_ACCOUNT=agent.bitpos-near.testnet
NEAR_PRIVATE_DIR=/Users/<you>/.bitpos-near/testnet
# Cross-chain PREVIEW through NEAR Intents: dry quotes only, nothing is executed (Intents has no testnet).
NEAR_INTENTS_PREVIEW=1
