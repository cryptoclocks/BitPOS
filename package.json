{
  "name": "bitpos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev:api": "tsx apps/api/src/index.ts",
    "dev:web": "astro dev --root apps/web --host 0.0.0.0",
    "dev:worker": "tsx apps/worker/src/index.ts",
    "build": "astro build --root apps/web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "tsx tools/runtime/migrate.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "latest",
    "@elysia/node": "latest",
    "@solana/kit": "8.4.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "@wallet-standard/app": "latest",
    "@wallet-standard/base": "latest",
    "astro": "7.3.6",
    "bs58": "6.0.0",
    "dotenv": "17.2.3",
    "elysia": "1.4.30",
    "pg": "8.17.2",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tweetnacl": "1.0.3",
    "ws": "8.18.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
