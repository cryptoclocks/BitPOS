DATABASE_URL=postgresql://bitpos_app:REPLACE@127.0.0.1:18780/postgres
ADMIN_DATABASE_URL=postgresql://postgres:REPLACE@127.0.0.1:18780/postgres
AUTH_URL=http://127.0.0.1:18781
AUTH_ANON_KEY=REPLACE_WITH_DEDICATED_AUTH_ANON_KEY
APP_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_URL=http://localhost:4321
SOLANA_RPC=https://api.devnet.solana.com
DEVNET_PRIVATE_DIR=/absolute/private/path
BITPOS_DEMO_QUICK_SIGNIN=0
# Public customer URLs must use HTTPS. Configure your own origin.
# BITPOS_CUSTOMER_PUBLIC_URL=https://pay.example.com
# Public role shortcuts are intentionally restricted to this dedicated devnet site.
# BITPOS_DEMO_PUBLIC_ORIGIN=https://pos.cashlessthailand.com
# OCI binds API loopback; LAN development retains its default listener.
# BITPOS_BIND_HOST=127.0.0.1
