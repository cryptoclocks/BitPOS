# PayPal AI Hackathon work (2026-10-31..11-12). See paypal-hackathon/PROVENANCE.md.
# Template for the PRIVATE PayPal env on the OCI host: /home/ubuntu/bitpos-private/paypal/paypal.env (chmod 600).
# Copy, fill on the host, never commit the filled file. infra/paypal/compose.yaml loads it after runtime.env,
# so these values win on overlap. Sandbox only: the API refuses to start with any other environment or host.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The sandbox BUSINESS account that receives payments (13 characters, "Account ID" in the sandbox dashboard).
PAYPAL_MERCHANT_ID=
# Filled after registering https://paypal-pay.cashlessthailand.com/paypal/webhooks in the sandbox app.
PAYPAL_WEBHOOK_ID=
# Merchant POS origin (also compiled into the web build) and the customer pay origin used in pay/return links.
PUBLIC_URL=https://paypal-pos.cashlessthailand.com
BITPOS_CUSTOMER_PUBLIC_URL=https://paypal-pay.cashlessthailand.com
# Opts the PayPal POS into the owner/manager/staff quick sign-in (its own shop and accounts only).
BITPOS_DEMO_PUBLIC_ORIGIN=https://paypal-pos.cashlessthailand.com
# Do NOT set BITPOS_AI_* here unless provider URL and model equal runtime.env: Café Copilot and its offer copy use the
# runtime AI configuration, and a different model would make the runtime worker block Copilot's copy jobs.
