# PayPal AI Hackathon work (2026-10-31..11-12). See paypal-hackathon/PROVENANCE.md.
# Copy to the repository root as `.env` for the LOCAL preview and tests only (disposable fixture database).
# Replace <you> with your OS user name (the fixture uses trust authentication on 127.0.0.1) and set APP_SECRET.
DATABASE_URL=postgresql://<you>@127.0.0.1:55466/bitpos_paypal_fixture
ADMIN_DATABASE_URL=postgresql://<you>@127.0.0.1:55466/bitpos_paypal_fixture
# tools/paypal/dev-auth.ts answers sign-in here for the fixture's demo owner.
AUTH_URL=http://127.0.0.1:55467
AUTH_ANON_KEY=local-fixture-anon
APP_SECRET=
PUBLIC_URL=http://127.0.0.1:4321/
SOLANA_RPC=https://api.devnet.solana.com
DEVNET_PRIVATE_DIR=/tmp/bitpos-devnet-unused
BITPOS_DEMO_QUICK_SIGNIN=0
